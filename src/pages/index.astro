---
import BaseLayout from "./BaseLayout.astro";
import SizeConverter from "../components/SizeConverter";
---

<BaseLayout title="SizeMY - Malaysia-first size converter">
	<h1 class="text-xl font-semibold">Size converter (Malaysia-first)</h1>
	<p class="mt-2 text-sm text-gray-600">
		Pick a category and a Malaysia size. We’ll show approximate conversions.
	</p>

	<div class="mt-4">
		<SizeConverter client:load />
	</div>
</BaseLayout>
